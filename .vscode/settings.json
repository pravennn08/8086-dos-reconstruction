{
  "files.associations": {"*.asm": "assembly", "*.inc": "assembly"},
  "files.eol": "\n",
  "[assembly]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "files.eol": "\r\n"
  },
  "masmtasm.ASM.assembler": "TASM",
  "masmtasm.ASM.emulator": "dosbox-x",
  "masmtasm.ASM.savefirst": true,
  "files.exclude": {"**/*.obj": true},
  "search.exclude": {".local": true, "build": true}
}
